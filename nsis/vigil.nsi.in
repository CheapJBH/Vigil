Function RunConfigurator
	Exec '"$INSTDIR\vigil-configurator.exe"'
FunctionEnd


######################################################################

Function .onInit
${GetParameters} $R0
!ifndef EDITION_STUDENT
${GetOptions} $R0 "/NoMaster" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_MASTER}
${EndIf}
!endif
!ifndef EDITION_TEACHER
${GetOptions} $R0 "/NoInterception" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_INTERCEPTION}
${EndIf}
!endif
UserInfo::GetAccountType
pop $0
${If} $0 != "admin"
	MessageBox mb_iconstop "Please run the installer with administrative rights!"
	SetErrorLevel 740 ;ERROR_ELEVATION_REQUIRED
	Quit
${EndIf}

# 已启用防删保护时，覆盖安装必须先解锁，否则连旧文件都删不掉
ReadRegStr $2 HKLM "SOFTWARE\VigilGuard" "Hash"
${If} $2 != ""
	${GetParameters} $R3
	${GetOptions} $R3 "/Unlock=" $R4
	${If} $R4 == ""
		MessageBox MB_OK|MB_ICONSTOP "${UNLOCK_HELP}"
		SetErrorLevel 1
		Quit
	${EndIf}
	ExecWait '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\netguard\VigilGuard.ps1" -Release -Password "$R4"' $5
	${If} $5 != 0
		MessageBox MB_OK|MB_ICONSTOP "口令错误，无法覆盖安装。"
		SetErrorLevel 1
		Quit
	${EndIf}
	DeleteRegValue HKLM "SOFTWARE\VigilGuard" "Released"
${EndIf}
FunctionEnd

######################################################################

Section -Icons_Reg
SetOutPath "$INSTDIR"
WriteUninstaller "$INSTDIR\uninstall.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\Vigil"
CreateShortCut "$SMPROGRAMS\Vigil\Vigil Configurator.lnk" "$INSTDIR\vigil-configurator.exe"
CreateShortCut "$SMPROGRAMS\Vigil\Uninstall Vigil.lnk" "$INSTDIR\uninstall.exe"
WriteIniStr "$INSTDIR\Vigil website.url" "InternetShortcut" "URL" "${WEB_SITE}"
CreateShortCut "$SMPROGRAMS\Vigil\Vigil Website.lnk" "$INSTDIR\Vigil website.url"
${EndIf}

WriteRegStr ${REG_ROOT} "${REG_APP_PATH}" "" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayName" "Vigil"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "UninstallString" "$INSTDIR\uninstall.exe"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayIcon" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayVersion" "${VERSION}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "Publisher" "${COMP_NAME}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "URLInfoAbout" "${WEB_SITE}"
SectionEnd

######################################################################

Section Uninstall
${INSTALL_TYPE}

# ---- 防删保护：先验口令解锁，否则后面一个文件都删不掉
ReadRegStr $2 HKLM "SOFTWARE\VigilGuard" "Hash"
${If} $2 != ""
	${If} $UnlockCode == ""
		${GetParameters} $R0
		${GetOptions} $R0 "/Unlock=" $UnlockCode
	${EndIf}
	${If} $UnlockCode == ""
		MessageBox MB_OK|MB_ICONSTOP "${UNLOCK_HELP}"
		Abort
	${EndIf}
	ExecWait '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\netguard\VigilGuard.ps1" -Release -Password "$UnlockCode"' $3
	${If} $3 != 0
		MessageBox MB_OK|MB_ICONSTOP "口令错误，已取消卸载。"
		Abort
	${EndIf}

	# 先摘掉策略代理任务，避免它在卸载过程中把保护重新加上
	ExecWait '"$SYSDIR\schtasks.exe" /Delete /TN "VigilPolicyAgent" /F' $4
	DeleteRegKey HKLM "SOFTWARE\VigilGuard"
${EndIf}

!ifndef EDITION_TEACHER
ExecWait '"$INSTDIR\vigil-wcli.exe" config set Service/SoftwareSASEnabled 0'
ExecWait '"$INSTDIR\vigil-wcli.exe" config set Network/FirewallExceptionEnabled 0'
# 默认界面语言设为简体中文（不设则 QLocale::C -> 英文界面）
ExecWait '"$INSTDIR\vigil-wcli.exe" config set UI/Language "System (zh_CN)"'
ExecWait '"$INSTDIR\vigil-wcli.exe" service unregister'
ExecWait '"$INSTDIR\interception\install-interception.exe" /uninstall'
!endif
# make sure the service is stopped and all file handles are released
Sleep 2000

${GetParameters} $R0
${GetOptions} $R0 "/ClearConfig" $R1
${IfNot} ${Errors}
	ExecWait '"$INSTDIR\vigil-wcli.exe" config clear'
${EndIf}

Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.TXT"
Delete "$INSTDIR\*.url"
RmDir /r "$INSTDIR\crypto"
RmDir /r "$INSTDIR\imageformats"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\platforms"
RmDir /r "$INSTDIR\styles"
RmDir /r "$INSTDIR\tls"
RmDir /r "$INSTDIR\translations"
RmDir /r "$INSTDIR\interception"
RmDir /r "$INSTDIR\netguard"
RmDir /r "$INSTDIR\classroom"

RmDir "$INSTDIR"

Delete "$SMPROGRAMS\Vigil\Vigil Master.lnk"
Delete "$SMPROGRAMS\Vigil\Vigil Configurator.lnk"
Delete "$SMPROGRAMS\Vigil\Vigil Classroom Policy.lnk"
Delete "$SMPROGRAMS\Vigil\Vigil Network Guard.lnk"
Delete "$SMPROGRAMS\Vigil\Vigil Classroom Sync.lnk"
Delete "$SMPROGRAMS\Vigil\Vigil Classroom Code.lnk"
Delete "$SMPROGRAMS\Vigil\Vigil Classroom Join.lnk"
Delete "$SMPROGRAMS\Vigil\Uninstall Vigil.lnk"
Delete "$SMPROGRAMS\Vigil\Vigil Website.lnk"
RmDir "$SMPROGRAMS\Vigil"

Delete "$DESKTOP\Vigil Master.lnk"

DeleteRegKey ${REG_ROOT} "${REG_APP_PATH}"
DeleteRegKey ${REG_ROOT} "${UNINSTALL_PATH}"
SectionEnd

######################################################################

Function un.onInit
!insertmacro MUI_UNGETLANGUAGE
FunctionEnd

######################################################################

; 卸载页：仅当本机启用了防删保护才出现，用于收集教师口令
Function un.UnlockPage
	ReadRegStr $0 HKLM "SOFTWARE\VigilGuard" "Hash"
	${If} $0 == ""
		Abort
	${EndIf}

	!insertmacro MUI_HEADER_TEXT "解除防删保护" "本机程序文件已锁定，卸载前需要教师口令。"
	nsDialogs::Create 1018
	Pop $0
	${If} $0 == error
		Abort
	${EndIf}

	${NSD_CreateLabel} 0 0 100% 30u "本机已启用防删保护，程序目录即使管理员也无法删除。$\r$\n请输入教师口令以解除保护并继续卸载。"
	Pop $0

	${NSD_CreateLabel} 0 38u 40u 12u "口令："
	Pop $0
	${NSD_CreatePassword} 40u 36u -40u 14u ""
	Pop $UnlockInput

	nsDialogs::Show
FunctionEnd

Function un.UnlockPageLeave
	${NSD_GetText} $UnlockInput $UnlockCode
	${If} $UnlockCode == ""
		MessageBox MB_OK|MB_ICONEXCLAMATION "请输入口令。"
		Abort
	${EndIf}
FunctionEnd

######################################################################

LangString DESC_SEC_SERVICE ${LANG_ENGLISH} "Vigil service and common files required on all computers"
LangString DESC_SEC_SERVICE ${LANG_GERMAN} "Vigil-Dienst und gemeinsame Dateien, die auf allen Computern benötigt werden"
LangString DESC_SEC_MASTER ${LANG_ENGLISH} "Master application for monitoring and controlling Vigil client computers"
LangString DESC_SEC_MASTER ${LANG_GERMAN} "Master-Applikation zum Beobachten und Steuern von Vigil-Client-Computern"
LangString DESC_SEC_INTERCEPTION ${LANG_ENGLISH} "Special input device driver required for intercepting keyboard shortcuts such as Ctrl+Alt+Del in screen lock mode"
LangString DESC_SEC_INTERCEPTION ${LANG_GERMAN} "Spezieller Eingabegerätetreiber, der zum Abfangen von Tastenkombinationen wie Strg+Alt+Entf im Bildschirmsperr-Modus benötigt wird"

