######################################################################

# 两端共用的文件集合：运行库、Qt 插件、翻译、辅助命令行工具。
# 教师端与学生端的差异只在 service / master / interception 三类组件。
!macro InstallCommonFiles
SetOutPath "$INSTDIR"
File "vigil-configurator.exe"
File "vigil-cli.exe"
File "vigil-wcli.exe"
File "vigil-worker.exe"
File "*.dll"
File "LICENSE.TXT"
File "README.TXT"
SetOutPath "$INSTDIR\plugins"
File "plugins/*.dll"
SetOutPath "$INSTDIR\translations"
File /nonfatal "translations/*.qm"
SetOutPath "$INSTDIR\crypto"
File /nonfatal "crypto/*.dll"
SetOutPath "$INSTDIR\imageformats"
File /nonfatal "imageformats/*.dll"
SetOutPath "$INSTDIR\platforms"
File "platforms/*.dll"
SetOutPath "$INSTDIR\styles"
File /nonfatal "styles/*.dll"
SetOutPath "$INSTDIR\tls"
File /nonfatal "tls/*.dll"
SetOutPath "$INSTDIR"
!macroend

######################################################################

!ifndef EDITION_TEACHER
Section "Vigil Service" SEC_SERVICE
SectionIn RO
${INSTALL_TYPE}
ClearErrors
ExecWait '"$INSTDIR\vigil-wcli.exe" service unregister'
${If} $0 != 0
  ExecWait '"$INSTDIR\vigil-ctl.exe" service unregister'
${EndIf}
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\plugins\*.dll"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\translations"
SetOverwrite on
SetOutPath "$INSTDIR"
# core components
File "vigil-server.exe"
File "vigil-service.exe"
!insertmacro InstallCommonFiles
# configuration
ExecWait '"$INSTDIR\vigil-wcli.exe" service register'
ExecWait '"$INSTDIR\vigil-wcli.exe" config set Network/FirewallExceptionEnabled 1'
ExecWait '"$INSTDIR\vigil-wcli.exe" config set Windows/SoftwareSASEnabled 1'
# disable forced guest logon as otherwise logon authentication fails
WriteRegDWORD ${REG_ROOT} "SYSTEM\CurrentControlSet\Control\Lsa"  "ForceGuest" "0"
${GetParameters} $R0
${GetOptions} $R0 "/ApplyConfig=" $R1
${If} $R1 != ""
  ClearErrors
  ExecWait '"$INSTDIR\vigil-wcli.exe" config import "$R1"' $0
  ${If} $0 != 0
	   MessageBox MB_OK|MB_ICONSTOP "Could not apply specified configuration file!"
  ${EndIf}
${EndIf}
ExecWait '"$INSTDIR\vigil-wcli.exe" service start'
SectionEnd
!endif

!ifndef EDITION_STUDENT
Section "Vigil Master" SEC_MASTER
${INSTALL_TYPE}
SetOverwrite on
SetOutPath "$INSTDIR"
!insertmacro InstallCommonFiles
File "vigil-master.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\Vigil"
CreateShortCut "$SMPROGRAMS\Vigil\Vigil Master.lnk" "$INSTDIR\${MAIN_APP_EXE}"
${EndIf}
CreateShortCut "$DESKTOP\Vigil Master.lnk" "$INSTDIR\${MAIN_APP_EXE}"
SectionEnd
!endif

!ifndef EDITION_TEACHER
Section "Interception driver" SEC_INTERCEPTION
${INSTALL_TYPE}
SetOutPath "$INSTDIR\interception"
File "interception/*"
SectionEnd
!endif

# ---------------------------------------------------------------- 课堂口令

!ifdef EDITION_TEACHER
Section "课堂口令 Classroom code" SEC_CLASSROOM
${INSTALL_TYPE}
SetOutPath "$INSTDIR\classroom"
File "classroom-teacher/VigilTeacherSetup.ps1"
File "classroom-teacher/VigilPairServer.ps1"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\Vigil"
CreateShortCut "$SMPROGRAMS\Vigil\课堂口令.lnk" "$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" \
	'-NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\classroom\VigilTeacherSetup.ps1"' \
	"$INSTDIR\vigil-master.exe" 0
${EndIf}
SectionEnd
!endif

!ifdef EDITION_STUDENT
Section "课堂口令 Classroom code" SEC_CLASSROOM
${INSTALL_TYPE}
SetOutPath "$INSTDIR\classroom"
File "classroom-student/VigilStudentSetup.ps1"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\Vigil"
CreateShortCut "$SMPROGRAMS\Vigil\绑定课堂.lnk" "$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" \
	'-NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\classroom\VigilStudentSetup.ps1"' \
	"$INSTDIR\vigil-server.exe" 0
${EndIf}
SectionEnd
!endif

Function RunConfigurator
	Exec '"$INSTDIR\vigil-configurator.exe"'
FunctionEnd


######################################################################

Function .onInit
${GetParameters} $R0
!ifndef EDITION_STUDENT
${GetOptions} $R0 "/NoMaster" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_MASTER}
${EndIf}
!endif
!ifndef EDITION_TEACHER
${GetOptions} $R0 "/NoInterception" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_INTERCEPTION}
${EndIf}
!endif
UserInfo::GetAccountType
pop $0
${If} $0 != "admin"
	MessageBox mb_iconstop "Please run the installer with administrative rights!"
	SetErrorLevel 740 ;ERROR_ELEVATION_REQUIRED
	Quit
${EndIf}
FunctionEnd

######################################################################

Section -Icons_Reg
SetOutPath "$INSTDIR"
WriteUninstaller "$INSTDIR\uninstall.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\Vigil"
CreateShortCut "$SMPROGRAMS\Vigil\Vigil Configurator.lnk" "$INSTDIR\vigil-configurator.exe"
CreateShortCut "$SMPROGRAMS\Vigil\Uninstall Vigil.lnk" "$INSTDIR\uninstall.exe"
WriteIniStr "$INSTDIR\Vigil website.url" "InternetShortcut" "URL" "${WEB_SITE}"
CreateShortCut "$SMPROGRAMS\Vigil\Vigil Website.lnk" "$INSTDIR\Vigil website.url"
${EndIf}

WriteRegStr ${REG_ROOT} "${REG_APP_PATH}" "" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayName" "Vigil"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "UninstallString" "$INSTDIR\uninstall.exe"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayIcon" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayVersion" "${VERSION}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "Publisher" "${COMP_NAME}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "URLInfoAbout" "${WEB_SITE}"
SectionEnd

######################################################################

Section Uninstall
${INSTALL_TYPE}

!ifndef EDITION_TEACHER
ExecWait '"$INSTDIR\vigil-wcli.exe" config set Service/SoftwareSASEnabled 0'
ExecWait '"$INSTDIR\vigil-wcli.exe" config set Network/FirewallExceptionEnabled 0'
ExecWait '"$INSTDIR\vigil-wcli.exe" service unregister'
ExecWait '"$INSTDIR\interception\install-interception.exe" /uninstall'
!endif
# make sure the service is stopped and all file handles are released
Sleep 2000

${GetParameters} $R0
${GetOptions} $R0 "/ClearConfig" $R1
${IfNot} ${Errors}
	ExecWait '"$INSTDIR\vigil-wcli.exe" config clear'
${EndIf}

Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.TXT"
Delete "$INSTDIR\*.url"
RmDir /r "$INSTDIR\crypto"
RmDir /r "$INSTDIR\imageformats"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\platforms"
RmDir /r "$INSTDIR\styles"
RmDir /r "$INSTDIR\tls"
RmDir /r "$INSTDIR\translations"
RmDir /r "$INSTDIR\interception"
RmDir /r "$INSTDIR\classroom"

RmDir "$INSTDIR"

Delete "$SMPROGRAMS\Vigil\Vigil Master.lnk"
Delete "$SMPROGRAMS\Vigil\Vigil Configurator.lnk"
Delete "$SMPROGRAMS\Vigil\课堂口令.lnk"
Delete "$SMPROGRAMS\Vigil\绑定课堂.lnk"
Delete "$SMPROGRAMS\Vigil\Uninstall Vigil.lnk"
Delete "$SMPROGRAMS\Vigil\Vigil Website.lnk"
RmDir "$SMPROGRAMS\Vigil"

Delete "$DESKTOP\Vigil Master.lnk"

DeleteRegKey ${REG_ROOT} "${REG_APP_PATH}"
DeleteRegKey ${REG_ROOT} "${UNINSTALL_PATH}"
SectionEnd

######################################################################

Function un.onInit
!insertmacro MUI_UNGETLANGUAGE
FunctionEnd

######################################################################

LangString DESC_SEC_SERVICE ${LANG_ENGLISH} "Vigil service and common files required on all computers"
LangString DESC_SEC_SERVICE ${LANG_GERMAN} "Vigil-Dienst und gemeinsame Dateien, die auf allen Computern benötigt werden"
LangString DESC_SEC_MASTER ${LANG_ENGLISH} "Master application for monitoring and controlling Vigil client computers"
LangString DESC_SEC_MASTER ${LANG_GERMAN} "Master-Applikation zum Beobachten und Steuern von Vigil-Client-Computern"
LangString DESC_SEC_INTERCEPTION ${LANG_ENGLISH} "Special input device driver required for intercepting keyboard shortcuts such as Ctrl+Alt+Del in screen lock mode"
LangString DESC_SEC_INTERCEPTION ${LANG_GERMAN} "Spezieller Eingabegerätetreiber, der zum Abfangen von Tastenkombinationen wie Strg+Alt+Entf im Bildschirmsperr-Modus benötigt wird"

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
