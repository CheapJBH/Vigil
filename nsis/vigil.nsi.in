!define APP_NAME "Vigil"
!define COMP_NAME "Vigil Solutions"
!define WEB_SITE "https://vigil.io"
!define VERSION "@VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@.@VERSION_BUILD@"
!define COPYRIGHT "2004-2026 Vigil Solutions / Tobias Junghans"
!define DESCRIPTION "Vigil Installer"
!define LICENSE_TXT "COPYING"
!ifdef EDITION_TEACHER
!define INSTALLER_NAME "vigil-teacher-${VERSION}-@VIGIL_WINDOWS_ARCH@-setup.exe"
!else ifdef EDITION_STUDENT
!define INSTALLER_NAME "vigil-student-${VERSION}-@VIGIL_WINDOWS_ARCH@-setup.exe"
!else
!define INSTALLER_NAME "vigil-${VERSION}-@VIGIL_WINDOWS_ARCH@-setup.exe"
!endif
!ifdef EDITION_STUDENT
!define MAIN_APP_EXE "vigil-server.exe"
!else
!define MAIN_APP_EXE "vigil-master.exe"
!endif
!define INSTALL_TYPE "SetShellVarContext all"
!define REG_ROOT "HKLM"
!define REG_APP_PATH "Software\Microsoft\Windows\CurrentVersion\App Paths\${MAIN_APP_EXE}"
!define UNINSTALL_PATH "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_NAME}"

######################################################################

VIProductVersion  "${VERSION}"
VIAddVersionKey "ProductName"  "${APP_NAME}"
VIAddVersionKey "CompanyName"  "${COMP_NAME}"
VIAddVersionKey "LegalCopyright"  "${COPYRIGHT}"
VIAddVersionKey "FileDescription"  "${DESCRIPTION}"
VIAddVersionKey "ProductVersion"  "${VERSION}"
VIAddVersionKey "FileVersion"  "${VERSION}"

######################################################################

SetCompressor /SOLID lzma
Unicode true
Name "${APP_NAME}"
Caption "${APP_NAME} ${VERSION}"
OutFile "${INSTALLER_NAME}"
BrandingText "${APP_NAME} ${VERSION}"
XPStyle on
InstallDirRegKey "${REG_ROOT}" "${REG_APP_PATH}" ""
InstallDir "$PROGRAMFILES64\Vigil"
ShowInstDetails hide
RequestExecutionLevel admin

######################################################################

!include "LogicLib.nsh"
!include "MUI2.nsh"
!include "FileFunc.nsh"

# makensis 的相对路径解析在 GitHub Actions 上不可靠，
# 由调用方用 -DNSIS_DIR=<staging 绝对路径> 显式指定。
!ifndef NSIS_DIR
  !define NSIS_DIR "."
!endif
!cd "${NSIS_DIR}"

######################################################################
# 防删保护：口令相关
Var UnlockCode      ; 卸载页 / /Unlock= 收集到的口令
Var UnlockInput     ; 卸载页输入框句柄

!define UNLOCK_HELP "本机已启用防删保护（程序文件无法删除）。$\r$\n覆盖安装或卸载需要教师口令：$\r$\n$\r$\n  /Unlock=<口令>$\r$\n$\r$\n口令由教师端“课堂口令”统一设置。"

!define MUI_ABORTWARNING
!define MUI_UNABORTWARNING

!define MUI_WELCOMEFINISHPAGE_BITMAP "welcome-page.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "welcome-page.bmp"

!define MUI_ICON "installer.ico"
!define MUI_UNICON "uninstaller.ico"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "header.bmp"
!define MUI_HEADERIMAGE_RIGHT

!define MUI_LANGDLL_REGISTRY_ROOT "${REG_ROOT}"
!define MUI_LANGDLL_REGISTRY_KEY "${UNINSTALL_PATH}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "Installer Language"

!insertmacro MUI_PAGE_WELCOME

!insertmacro MUI_PAGE_LICENSE "${LICENSE_TXT}"

!insertmacro MUI_PAGE_DIRECTORY

!insertmacro MUI_PAGE_COMPONENTS

!insertmacro MUI_PAGE_INSTFILES

!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_TEXT "Run Vigil Configurator now"
!define MUI_FINISHPAGE_RUN_FUNCTION "RunConfigurator"
!define MUI_FINISHPAGE_LINK "Support Vigil project with a donation"
!define MUI_FINISHPAGE_LINK_LOCATION "https://www.paypal.com/cgi-bin/webscr?item_name=Donation+to+Vigil+-+OpenSource+classroom+management&cmd=_donations&business=donate%40vigil.io"

!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM

UninstPage custom un.UnlockPage un.UnlockPageLeave

!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "SimpChinese" ; 默认界面语言：简体中文

!insertmacro MUI_RESERVEFILE_LANGDLL

######################################################################

# 两端共用的文件集合：运行库、Qt 插件、翻译、辅助命令行工具。
# 教师端与学生端的差异只在 service / master / interception 三类组件。
!macro InstallCommonFiles
SetOutPath "$INSTDIR"
File "vigil-configurator.exe"
File "vigil-cli.exe"
File "vigil-wcli.exe"
File "vigil-worker.exe"
File "*.dll"
File "LICENSE.TXT"
File "README.TXT"
SetOutPath "$INSTDIR\plugins"
File "plugins\*.dll"
SetOutPath "$INSTDIR\translations"
File /nonfatal "translations\*.qm"
SetOutPath "$INSTDIR\crypto"
File /nonfatal "crypto\*.dll"
SetOutPath "$INSTDIR\imageformats"
File /nonfatal "imageformats\*.dll"
SetOutPath "$INSTDIR\platforms"
File "platforms\*.dll"
SetOutPath "$INSTDIR\styles"
File /nonfatal "styles\*.dll"
SetOutPath "$INSTDIR\tls"
File /nonfatal "tls\*.dll"
SetOutPath "$INSTDIR"
!macroend

######################################################################

!ifndef EDITION_TEACHER
Section "Vigil Service" SEC_SERVICE
SectionIn RO
${INSTALL_TYPE}
ClearErrors
ExecWait '"$INSTDIR\vigil-wcli.exe" service unregister'
${If} $0 != 0
  ExecWait '"$INSTDIR\vigil-ctl.exe" service unregister'
${EndIf}
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\plugins\*.dll"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\translations"
SetOverwrite on
SetOutPath "$INSTDIR"
# core components
File "vigil-server.exe"
File "vigil-service.exe"
!insertmacro InstallCommonFiles
# configuration
ExecWait '"$INSTDIR\vigil-wcli.exe" service register'
ExecWait '"$INSTDIR\vigil-wcli.exe" config set Network/FirewallExceptionEnabled 1'
ExecWait '"$INSTDIR\vigil-wcli.exe" config set Windows/SoftwareSASEnabled 1'
# 默认界面语言设为简体中文（不设则 QLocale::C -> 英文界面）
ExecWait '"$INSTDIR\vigil-wcli.exe" config set UI/Language "System (zh_CN)"'
# disable forced guest logon as otherwise logon authentication fails
WriteRegDWORD ${REG_ROOT} "SYSTEM\CurrentControlSet\Control\Lsa"  "ForceGuest" "0"
${GetParameters} $R0
${GetOptions} $R0 "/ApplyConfig=" $R1
${If} $R1 != ""
  ClearErrors
  ExecWait '"$INSTDIR\vigil-wcli.exe" config import "$R1"' $0
  ${If} $0 != 0
	   MessageBox MB_OK|MB_ICONSTOP "Could not apply specified configuration file!"
  ${EndIf}
${EndIf}
ExecWait '"$INSTDIR\vigil-wcli.exe" service start'
SectionEnd
!endif

!ifndef EDITION_STUDENT
Section "Vigil Master" SEC_MASTER
${INSTALL_TYPE}
SetOverwrite on
SetOutPath "$INSTDIR"
!insertmacro InstallCommonFiles
File "vigil-master.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\Vigil"
CreateShortCut "$SMPROGRAMS\Vigil\Vigil Master.lnk" "$INSTDIR\${MAIN_APP_EXE}"
${EndIf}
CreateShortCut "$DESKTOP\Vigil Master.lnk" "$INSTDIR\${MAIN_APP_EXE}"
SectionEnd
!endif

!ifndef EDITION_TEACHER
Section "Interception driver" SEC_INTERCEPTION
${INSTALL_TYPE}
SetOutPath "$INSTDIR\interception"
File "interception\*"
SectionEnd
!endif

# ---------------------------------------------------------------- 课堂口令

!ifdef EDITION_TEACHER
Section "课堂口令 Classroom code" SEC_CLASSROOM
${INSTALL_TYPE}
SetOutPath "$INSTDIR\classroom"
File "classroom-teacher\VigilTeacherSetup.ps1"
File "classroom-teacher\VigilPairServer.ps1"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\Vigil"
CreateShortCut "$SMPROGRAMS\Vigil\Vigil Classroom Code.lnk" "$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" \
	'-NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\classroom\VigilTeacherSetup.ps1"' \
	"$INSTDIR\vigil-master.exe" 0
${EndIf}
SectionEnd
